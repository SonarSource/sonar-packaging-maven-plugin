import java.io.*;
import java.util.jar.*;
import java.util.zip.*;

File jarFile = new File(basedir, "plugin/target/test-plugin-1.0.jar");
if (!jarFile.isFile()) {
  throw new FileNotFoundException("Could not find generated JAR: " + jarFile);
}

File zipFile = new File(basedir, "zip/target/test-zip-1.0.zip");
if (!zipFile.isFile()) {
  throw new FileNotFoundException("Could not find generated ZIP: " + zipFile);
}

ZipFile zip = new ZipFile(zipFile);
try {
  if (zip.getEntry("plugin/test-plugin-1.0.jar") == null) {
    throw new FileNotFoundException("Zip does not contain plugin/test-plugin-1.0.jar");
  }
  if (zip.getEntry("resources/static/models/sample.txt") == null) {
    throw new FileNotFoundException("Zip does not contain resources/static/models/sample.txt");
  }

  InputStream jarEntryStream = zip.getInputStream(zip.getEntry("plugin/test-plugin-1.0.jar"));
  try {
    JarInputStream innerJar = new JarInputStream(jarEntryStream);
    try {
      Manifest manifest = innerJar.getManifest();
      if (manifest == null) {
        throw new FileNotFoundException("Nested jar has no manifest");
      }
      String pluginKey = manifest.getMainAttributes().getValue("Plugin-Key");
      if (!"test".equals(pluginKey)) {
        throw new IllegalStateException("Expected Plugin-Key=test in nested jar manifest, got: " + pluginKey);
      }
      String pluginVersion = manifest.getMainAttributes().getValue("Plugin-Version");
      if (!"1.0".equals(pluginVersion)) {
        throw new IllegalStateException("Expected Plugin-Version=1.0 in nested jar manifest, got: " + pluginVersion);
      }
    } finally {
      innerJar.close();
    }
  } finally {
    jarEntryStream.close();
  }
} finally {
  zip.close();
}

// The "plugin" module has no static resources of its own, so there's no overlap with the "zip" module's
// resourcesDirectory: no "duplicated in the JAR" warning should be logged (see "zipPackagingDuplicateResources"
// for that case).
File log = new File(basedir, "build.log");
if (!log.isFile()) {
  throw new FileNotFoundException("Could not find log file: " + log);
}
for (String line : java.nio.file.Files.readAllLines(log.toPath())) {
  if (line.contains("is also packaged inside the plugin JAR")) {
    throw new IllegalStateException("Unexpected duplication warning logged: " + line);
  }
}
