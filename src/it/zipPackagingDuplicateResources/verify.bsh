import java.io.*;
import java.nio.file.*;
import java.util.jar.*;
import java.util.zip.*;

File jarFile = new File(basedir, "target/test-1.0.jar");
if (!jarFile.isFile()) {
  throw new FileNotFoundException("Could not find generated JAR: " + jarFile);
}

File zipFile = new File(basedir, "target/test-1.0.zip");
if (!zipFile.isFile()) {
  throw new FileNotFoundException("Could not find generated ZIP: " + zipFile);
}

// Confirm the premise: with no <includes> scoping, the resourcesDirectory content ends up in both artifacts.
ZipFile jar = new ZipFile(jarFile);
try {
  if (jar.getEntry("static/models/sample.txt") == null) {
    throw new IllegalStateException("static/models/sample.txt should be present in target/test-1.0.jar "
      + "for this duplication scenario to be meaningful");
  }
} finally {
  jar.close();
}

ZipFile zip = new ZipFile(zipFile);
try {
  if (zip.getEntry("resources/models/sample.txt") == null) {
    throw new FileNotFoundException("Zip does not contain resources/models/sample.txt");
  }
} finally {
  zip.close();
}

// The build must have warned about the duplication.
File log = new File(basedir, "build.log");
if (!log.isFile()) {
  throw new FileNotFoundException("Could not find log file: " + log);
}

boolean found = false;
for (String line : Files.readAllLines(log.toPath())) {
  if (line.startsWith("[WARNING]")
    && line.contains("is also packaged inside the plugin JAR")
    && line.contains("included twice")
    && line.contains("moved out of the JAR")) {
    found = true;
  }
}

if (!found) {
  throw new Exception("Expected warning about resourcesDirectory content being duplicated in the plugin JAR was not logged");
}
