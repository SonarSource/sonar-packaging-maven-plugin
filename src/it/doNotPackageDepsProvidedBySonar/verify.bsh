import java.io.*;
import java.util.zip.*;

File file = new File( basedir, "target/test-1.0.jar" );
if (!file.isFile()) {
  throw new FileNotFoundException( "Could not find generated JAR: " + file );
}

ZipFile zipFile = new ZipFile(file);
try {
  Enumeration entries = zipFile.entries();
  while (entries.hasMoreElements()) {
    ZipEntry entry = (ZipEntry) entries.nextElement();
    if (entry.getName().startsWith("META-INF/lib/commons-lang-")) {
      throw new IllegalStateException("The dependency commons-lang must not be copied in the plugin: " + entry.getName());
    }
  }
} finally {
  zipFile.close();
}
